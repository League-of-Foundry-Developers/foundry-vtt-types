import type { InexactPartial } from "#utils";
import type { Canvas } from "#client/canvas/_module.d.mts";
import * as _PIXI from "pixi.js";

/**
 * Extend PIXI.Ellipse with new methods.
 */
export default function extendPIXIEllipse(): void;

declare global {
  namespace PIXI {
    interface Ellipse {
      /**
       * Determine the center of the ellipse.
       * Trivial, but used to match center method for other shapes.
       * @remarks `defineProperty`'d with no explicit options
       */
      get center(): PIXI.Point;

      /**
       * Determine if a point is on or nearly on this ellipse.
       * @param point   - Point to test
       * @param epsilon - Tolerated margin of error (default: `1e-08`)
       * @returns Is the point on the ellipse within the allowed tolerance?
       */
      pointIsOn(point: Canvas.Point, epsilon?: number): boolean;

      /**
       * Calculate an x,y point on this ellipse's circumference given an angle
       * - `0`: due east
       * - `π / 2`: due south
       * - `π` or `-π`: due west
       * - `-π/2`: due north
       * @param angle - Angle of the point, in radians
       * @returns The point on the ellipse at the given angle
       */
      pointAtAngle(angle: number): Canvas.Point;

      /**
       * Get all the points for a polygon approximation of this ellipse between two points.
       * The two points can be anywhere in 2d space. The intersection of this ellipse with the line from this ellipse center
       * to the point will be used as the start or end point, respectively.
       * This is used to draw the portion of the ellipse (the arc) between two intersection points on this ellipse.
       * @param a       - Point in 2d space representing the start point
       * @param b       - Point in 2d space representing the end point
       * @param options - Options passed on to the pointsForArc method
       * @returns An array of points arranged clockwise from start to end
       * @remarks Assigned from {@linkcode PIXI.Circle.pointsBetween | PIXI.Circle#pointsBetween}.
       */
      pointsBetween(a: Canvas.Point, b: Canvas.Point, options?: Ellipse.PointsForArcOptions): Canvas.Point[];

      /**
       * Get the points that would approximate a circular arc along this ellipse, given a starting and ending angle.
       * Points returned are clockwise. If from and to are the same, a full ellipse will be returned.
       * @param fromAngle - Starting angle, in radians. `π` is due north, `π/2` is due east
       * @param toAngle   - Ending angle, in radians
       * @param options   - Options which affect how the ellipse is converted
       * @returns An array of points along the requested arc
       * @remarks Returns `[]` if the ellipse has no width or height.
       */
      pointsForArc(fromAngle: number, toAngle: number, options?: Ellipse.PointsForArcOptions): Canvas.Point[];

      /**
       * Approximate this PIXI.Ellipse as a PIXI.Polygon
       * @param options - Options forwarded on to the pointsForArc method
       * @returns The Ellipse expressed as a PIXI.Polygon
       * @remarks Assigned from {@linkcode PIXI.Circle.toPolygon | PIXI.Circle#toPolygon}.
       */
      toPolygon(options?: Ellipse.PointsForArcOptions): PIXI.Polygon;

      /**
       * Intersect this PIXI.Ellipse with a PIXI.Polygon.
       * @param polygon - A PIXI.Polygon
       * @param options - Options which configure how the intersection is computed
       * @returns The intersected polygon
       */
      intersectPolygon(polygon: PIXI.Polygon, options?: Ellipse.IntersectPolygonOptions): PIXI.Polygon;

      /**
       * Intersect this PIXI.Ellipse with an array of ClipperPoints.
       * Convert the ellipse to a Polygon approximation and use intersectPolygon.
       * In the future we may replace this with more specialized logic which uses the line-ellipse intersection formula.
       * @param clipperPoints - Array of ClipperPoints generated by PIXI.Polygon.toClipperPoints()
       * @param options       - Options which configure how the intersection is computed
       * @returns The intersected polygon
       * @remarks Assigned from {@linkcode PIXI.Circle.intersectClipper | PIXI.Circle#intersectClipper}.
       * @privateRemarks Foundry's description says "polygon" and its `@returns` type says `ClipperPoint[]`; the runtime
       * forwards to {@linkcode PIXI.Polygon.intersectClipper | PIXI.Polygon#intersectClipper} and so yields that
       * method's {@linkcode ClipperLib.Paths} solution
       */
      intersectClipper(
        clipperPoints: PIXI.Polygon.ClipperPoint[],
        options?: Ellipse.IntersectClipperOptions,
      ): PIXI.Polygon.ClipperPath[];
    }

    namespace Ellipse {
      /** @internal */
      interface _DensityOptions {
        /**
         * The number of points which defines the density of approximation
         * @defaultValue {@linkcode PIXI.Ellipse.approximateVertexDensity | PIXI.Ellipse.approximateVertexDensity(this.width, this.height)}
         */
        density: number;
      }

      /** @internal */
      interface _PointsForArcOptions extends _DensityOptions {
        /**
         * Whether to include points at the ellipse where the arc starts and ends
         * @defaultValue `true`
         */
        includeEndpoints: boolean;
      }

      interface PointsForArcOptions extends InexactPartial<_PointsForArcOptions> {}

      /**
       * @remarks `density` is used to approximate the ellipse; the remaining options are passed on to
       * {@linkcode PIXI.Polygon.intersectPolygon | PIXI.Polygon#intersectPolygon}.
       */
      interface IntersectPolygonOptions extends PIXI.Polygon.IntersectPolygonOptions, InexactPartial<_DensityOptions> {}

      interface IntersectClipperOptions extends PIXI.Polygon.IntersectClipperOptions, InexactPartial<_DensityOptions> {}
    }

    class Ellipse extends _PIXI.Ellipse {
      /**
       * The recommended vertex density for the regular polygon approximation of a ellipse of a given radius.
       * Small radius ellipses have fewer vertices. The returned value will be rounded up to the nearest integer.
       * See the formula described at:
       * {@link https://math.stackexchange.com/questions/4132060/compute-number-of-regular-polgy-sides-to-approximate-ellipse-to-defined-precision}
       * @param width   - Ellipse radius X
       * @param height  - Ellipse radius Y
       * @param epsilon - The maximum tolerable distance between an approximated line segment and the true radius.
       *  A larger epsilon results in fewer points for a given radius. (default: `1`)
       * @returns The number of points for the approximated polygon
       */
      static approximateVertexDensity(width: number, height: number, epsilon?: number): number;
    }
  }
}
